# إعدادات السيرفر فقط. لا ترفع القيم الحقيقية إلى GitHub.
# المفتاح يمكن إدخاله لاحقًا من لوحة الإدارة؛ عندها يُشفّر على السيرفر.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000
PORT=8787

# سر قوي خاص بالسيرفر لتشفير مفتاح OpenAI المخزن من لوحة الإدارة.
# استخدم قيمة طويلة وعشوائية واحفظها كـ Secret لدى مزود الاستضافة.
SERVER_MASTER_KEY=ضع_هنا_سرا_طويلا_وعشوائيا

# اختياري: إذا رغبت بإدارة المفتاح مباشرة من بيئة السيرفر بدل لوحة الإدارة.
# OPENAI_API_KEY=sk-...

# حساب الإدارة المسموح له بإدارة إعدادات الذكاء الاصطناعي.
ADMIN_EMAIL=bajanznsb@gmail.com

# Firebase Admin يحتاج Application Default Credentials على الاستضافة
# (Cloud Run / Firebase / Google Cloud) أو GOOGLE_APPLICATION_CREDENTIALS محليًا.
